#!/usr/bin/env bash
# Starts the launchd agent. Installs the plist first if it is missing.
source "$(dirname "$0")/lib.sh"

[ -f "$ENV_FILE" ] || die "no .env. Run bin/setup first."
[ -f "$PLIST" ] || write_plist

if agent_loaded; then
  say "Agent already loaded, kicking it"
  launchctl kickstart "$SERVICE"
else
  say "Loading $LABEL"
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
fi

if wait_for_server; then
  say "Listening on $(local_url), public URL $(public_url)"
else
  die "server did not answer on $(local_url)/mcp. See bin/logs"
fi
