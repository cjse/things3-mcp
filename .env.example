# Public base URL of this server (no trailing slash). The OAuth issuer and the
# MCP resource URL (MCP_PUBLIC_URL/mcp) derive from it.
MCP_PUBLIC_URL=https://your-mac.your-tailnet.ts.net

# Password typed on the OAuth consent page. Generate with: openssl rand -base64 32
MCP_LOGIN_PASSWORD=

# Optional static bearer token for Claude Code (skips OAuth). Empty disables it.
MCP_AUTH_TOKEN=

# Where oauth.json (clients and hashed tokens) is stored. Default: ./data
# MCP_DATA_DIR=/Users/you/things3-mcp/data

# Puma port on 127.0.0.1. Default 9292.
# PORT=9292
